# ---- All keys are OPTIONAL. Without them the system runs fully offline
# ---- using deterministic local agents (great for a guaranteed live demo).

# LLM (pick one)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
DEEPGRAM_API_KEY=

# Avatar (tier 1: HeyGen, tier 2: your LivePortrait/SadTalker worker)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
AVATAR_WORKER_URL=

# Frontend -> backend (used by next.config.js rewrites)
BACKEND_URL=http://127.0.0.1:8000
